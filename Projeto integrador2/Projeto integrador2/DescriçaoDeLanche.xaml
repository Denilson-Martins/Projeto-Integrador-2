        <Button Content="Voltar" HorizontalAlignment="Left" VerticalAlignment="Top" Height="56" Width="148" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Black" Foreground="#FFFF5D00" Background="{x:Null}" BorderBrush="#FFF10000" Canvas.Left="69" Canvas.Top="338" Margin="0,394,0,0"/>
