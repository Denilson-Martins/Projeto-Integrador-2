<Page x:Class="Projeto_integrador2.Descrição_do_produto"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Projeto_integrador2"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Descrição_do_produto">
    <Viewbox Stretch="Fill">
        <Canvas Width="800" Height="450">
            <Canvas.Background>
                <ImageBrush ImageSource="/DescriçãoDeBebida-Background.png"/>
            </Canvas.Background>


            <Image Source="/img (2).jpeg" Stretch="Fill" Canvas.Left="46" Canvas.Top="28"/>
            <Label Content="Cappuccino" HorizontalAlignment="Left" Margin="400,28,0,0" VerticalAlignment="Top" FontSize="20" Height="37" Width="114" Foreground="White">
                <Label.Background>
                    <ImageBrush/>
                </Label.Background>
            </Label>
            <TextBox HorizontalAlignment="Left" TextWrapping="Wrap" Text="Uma combinação equilibrada de café espresso encorpado, leite vaporizado e uma camada cremosa de espuma de leite. Finalizado com um toque de  canela, oferece aroma marcante, textura aveludada e sabor suave, perfeito para qualquer momento do dia." VerticalAlignment="Center" Width="390" FontSize="16" Height="108" Canvas.Left="389" Canvas.Top="70" Foreground="White">
                <TextBox.Background>
                    <ImageBrush/>
                </TextBox.Background>
                <TextBox.BorderBrush>
                    <ImageBrush/>
                </TextBox.BorderBrush>
            </TextBox>
            <Label Content="Ingredientes" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Height="38" Width="120" Canvas.Left="400" Canvas.Top="198" Foreground="White"/>
            <TextBox HorizontalAlignment="Center" TextWrapping="Wrap" Text="leite em pó &#xD;&#xA;café solúvel &#xD;&#xA;achocolatado em pó&#xD;&#xA;açúcar &#xD;&#xA;canela em pó &#xD;&#xA;bicarbonato de sódio" VerticalAlignment="Top" Width="390" FontSize="16" Grid.RowSpan="2" Height="130" Grid.Row="1" Canvas.Left="400" Canvas.Top="256" Foreground="White">
                <TextBox.Background>
                    <ImageBrush/>
                </TextBox.Background>
                <TextBox.BorderBrush>
                    <ImageBrush/>
                </TextBox.BorderBrush>
            </TextBox>
            <Label Content="Preço" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="16" Height="30" Width="50" RenderTransformOrigin="0.503,1.593" Canvas.Left="148" Canvas.Top="225" Foreground="White"/>
            <Label Content="R$ 6,00" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="16" Height="31" Width="72" Grid.RowSpan="2" Canvas.Left="51" Canvas.Top="271" Foreground="White"/>
            <Label Content="R$ 12,00" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Height="31" Width="72" Grid.RowSpan="2" Canvas.Left="173" Canvas.Top="271" Foreground="White"/>

            <Button Style="{StaticResource VoltarButtonStyle}" Tag="Cappuccino"  Content="100ml" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="16" Click="BtnCapMl" Height="44" Grid.Row="2" Width="77" Canvas.Left="46" Canvas.Top="302" RenderTransformOrigin="-0.523,-0.519" Foreground="White">
                <Button.Background>
                    <ImageBrush/>
                </Button.Background>
            </Button>
            <Button Style="{StaticResource VoltarButtonStyle}" Tag="Cappuccino" Content="200ml" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Click="BtnCapMl" Height="43" Grid.Row="2" Width="72" Canvas.Left="173" Canvas.Top="302" RenderTransformOrigin="0.092,12.341" Foreground="White">
                <Button.Background>
                    <ImageBrush/>
                </Button.Background>
            </Button>

            <Button Style="{StaticResource VoltarButtonStyle}" Content="Voltar" HorizontalAlignment="Center" VerticalAlignment="Top" Height="56" Width="148" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Black" Foreground="#FFE84242" Grid.Row="2" Click="Button_Click" BorderBrush="Red" Canvas.Left="27" Canvas.Top="367">
                <Button.Background>
                    <ImageBrush/>
                </Button.Background>
            </Button>


        </Canvas>
    </Viewbox>

</Page>
