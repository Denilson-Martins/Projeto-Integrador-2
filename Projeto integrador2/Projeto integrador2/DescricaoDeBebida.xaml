<Page x:Class="Projeto_integrador2.Descrição_do_produto"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Projeto_integrador2"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Descrição_do_produto">

    <Page.Resources>
        <Style x:Key="PainelVidro" TargetType="Border">
            <Setter Property="Background" Value="#B3161616"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Opacity="0.45"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Viewbox Stretch="Fill">
        <Canvas Width="800" Height="450">
            <Canvas.Background>
                <ImageBrush ImageSource="/DescriçãoDeBebida-Background.png"/>
            </Canvas.Background>

            <StackPanel Canvas.Left="40" Canvas.Top="40" Width="320" Orientation="Vertical">
                <Border Width="320" Height="180" CornerRadius="18">
                    <Border.Background>
                        <ImageBrush ImageSource="/ChatGPT Image 29 de jul. de 2026, 20_37_39.png"/>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
                    </Border.Effect>
                    <Border.OpacityMask>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Border Background="White" CornerRadius="18" Width="320" Height="180"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.OpacityMask>
                </Border>

                <Border Width="320" CornerRadius="14" Background="#B3161616" BorderBrush="#26FFFFFF" BorderThickness="1" Margin="0,16,0,0">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="3" Opacity="0.4"/>
                    </Border.Effect>
                    <Grid Margin="16,10,16,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="PREÇO" FontSize="13" FontWeight="Bold" Foreground="#E8B96B" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="R$ 6,00" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="R$ 12,00" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>

                        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource VoltarButtonStyle}" Tag="Cappuccino" Content="100ml" FontSize="15" Click="BtnCapMl" Height="38" Width="90" Margin="0,8,6,0" HorizontalAlignment="Center">
                            <Button.Background>
                                <ImageBrush/>
                            </Button.Background>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource VoltarButtonStyle}" Tag="Cappuccino" Content="200ml" FontSize="15" Click="BtnCapMl" Height="38" Width="90" Margin="6,8,0,0" HorizontalAlignment="Center" >
                            <Button.Background>
                                <ImageBrush/>
                            </Button.Background>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Canvas.Left="400" Canvas.Top="40" Width="360" Orientation="Vertical">
                <Label Content="Cappuccino" FontSize="24" FontWeight="Bold" FontFamily="Segoe UI Semibold" Foreground="White" Padding="0"/>
                <Rectangle Width="56" Height="3" Fill="#E8B96B" Margin="4,2,0,0" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left"/>

                <Border Style="{StaticResource PainelVidro}" Width="360" Margin="0,10,0,0">
                    <TextBlock Text="Uma combinação equilibrada de café espresso encorpado, leite vaporizado e uma camada cremosa de espuma de leite. Finalizado com um toque de canela, oferece aroma marcante, textura aveludada e sabor suave, perfeito para qualquer momento do dia."
                               TextWrapping="Wrap" FontSize="14" LineHeight="19" Foreground="#F2F2F2" FontFamily="Segoe UI"/>
                </Border>

                <Label Content="INGREDIENTES" FontSize="13" FontWeight="Bold" Foreground="#E8B96B" Margin="0,12,0,4"/>
                <Border Style="{StaticResource PainelVidro}" Width="360">
                    <TextBlock Text="Leite em pó&#x0a;Café solúvel&#x0a;Achocolatado em pó&#x0a;Açúcar&#x0a;Canela em pó&#x0a;Bicarbonato de sódio"
                               TextWrapping="Wrap" FontSize="14" LineHeight="19" Foreground="#F2F2F2" FontFamily="Segoe UI"/>
                </Border>
            </StackPanel>

            <Button Style="{StaticResource VoltarButtonStyle}" Content="Voltar" HorizontalAlignment="Left" VerticalAlignment="Top" Height="48" Width="148" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Black" Click="Button_Click" Canvas.Left="32" Canvas.Top="392">
                <Button.Background>
                    <ImageBrush/>
                </Button.Background>
            </Button>

        </Canvas>
    </Viewbox>

</Page>
