<Page x:Class="Projeto_integrador2.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Projeto_integrador2"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Home">

    <Viewbox Stretch="Fill">
        <Canvas Width="800" Height="450">
            <Canvas.Background>
                <ImageBrush ImageSource="Img/img (4).png"/>
            </Canvas.Background>


            <Button Style="{StaticResource VoltarButtonStyle}" Content="ENTRAR" HorizontalAlignment="Left" VerticalAlignment="Center" Height="56" Width="148" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Black" Foreground="#FFF1D7AC" Background="{x:Null}" Click="btnEntrar_CLick" Canvas.Left="326" Canvas.Top="384"/>

            <Image Source="Img/img (8).png" Stretch="Fill" Canvas.Left="563" Height="191" Width="237" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Button Content="Button" HorizontalAlignment="Center" VerticalAlignment="Top" Height="164" Width="186" Click="BtnLogAdm" BorderThickness="0,0,0,0" Canvas.Top="8">
                <Button.Background>
                    <ImageBrush ImageSource="Img/img (7).png"/>
                </Button.Background>
            </Button>

        </Canvas>

    </Viewbox>


</Page>
