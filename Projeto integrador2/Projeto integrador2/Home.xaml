<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Projeto_integrador2"
      xmlns:Encoders="clr-namespace:K4os.Compression.LZ4.Encoders;assembly=K4os.Compression.LZ4" x:Class="Projeto_integrador2.Home"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Home">
    <Page.Background>
        <ImageBrush ImageSource="/graos cafe.jpg"/>
    </Page.Background>
    <Grid>

        <Canvas Margin="270,25,240,140">
            <Canvas.Background>
                <ImageBrush ImageSource="/LOGO CAFE.png"/>
            </Canvas.Background>

            <Button Content="ENTRAR" HorizontalAlignment="Center" VerticalAlignment="Top" Height="56" Width="148" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Black" Foreground="Red" Background="{x:Null}" Click="btnEntrar_CLick" x:Name="btnEntrar"  BorderBrush="#FFF10000" Canvas.Left="65" Canvas.Top="290"/>
            <Button Content="LOGAR" HorizontalAlignment="Center" VerticalAlignment="Top" Height="56" Width="148" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Black" Foreground="Red" Background="{x:Null}" Click="btnlogar_CLick" x:Name="btnLogar"  BorderBrush="#FFF10000" Canvas.Left="65" Canvas.Top="351"/>

            <Image Height="100" Canvas.Left="400" Canvas.Top="170" Width="100"/>
        </Canvas>
    </Grid>

</Page>
