<Page x:Class="Projeto_integrador2.ControleDeEstoque"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Projeto_integrador2"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ControleDeEstoque">

    <Grid Background="White">
        <DataGrid x:Name="DgCe"
          AutoGenerateColumns="False" CanUserDeleteRows="False"
           Width="780" Height="180"
           Canvas.Left="20" Canvas.Top="54"
          HorizontalAlignment="Center" VerticalAlignment="Center" IsReadOnly="True" SelectionChanged="DgCe_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome"       Binding="{Binding Nome}"      Width="*"/>
                <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Page>
