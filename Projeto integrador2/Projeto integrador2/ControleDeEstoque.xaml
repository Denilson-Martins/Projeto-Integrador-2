<Page x:Class="Projeto_integrador2.ControleDeEstoque"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Projeto_integrador2"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="ControleDeEstoque" Loaded="Page_Loaded">

    <Viewbox Stretch="Fill">
        <Grid Width="800" Height="500">
            <Grid.Background>
                <ImageBrush ImageSource="/Background3.png" Stretch="UniformToFill"/>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource AdminCardStyle}" HorizontalAlignment="Center"
            Margin="0,18,0,12" Padding="26,10">
                <TextBlock Text="Controle de Estoque" Style="{StaticResource AdminTitleStyle}"/>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource AdminCardStyle}" Margin="30,0,30,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel Margin="8,0" Width="180">
                            <TextBlock Text="Produto" Style="{StaticResource AdminLabelStyle}"/>
                            <TextBox x:Name="TxtNomeProduto" Style="{StaticResource AdminTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="8,0" Width="90">
                            <TextBlock Text="Tamanho" Style="{StaticResource AdminLabelStyle}"/>
                            <TextBox x:Name="TxtTamanho" Style="{StaticResource AdminTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="8,0" Width="90">
                            <TextBlock Text="Preço" Style="{StaticResource AdminLabelStyle}"/>
                            <TextBox x:Name="TxtPreco" Style="{StaticResource AdminTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="8,0" Width="100">
                            <TextBlock Text="Quantidade" Style="{StaticResource AdminLabelStyle}"/>
                            <TextBox x:Name="TxtQuantidade" Style="{StaticResource AdminTextBoxStyle}"/>
                        </StackPanel>
                        <Button x:Name="BtnAdicionar" Content="Adicionar" Style="{StaticResource AdminPrimaryButtonStyle}"
                        Margin="8,20,4,0" Click="BtnAdicionar_Click"/>
                        <Button x:Name="BtnAtualizarProduto" Content="Atualizar" Style="{StaticResource AdminSecondaryButtonStyle}"
                        Margin="4,20,8,0" Click="BtnAtualizarProduto_Click"/>
                    </StackPanel>
                    <TextBlock Text="Clique em um produto na tabela abaixo para carregar os dados dele aqui e editar"
                       HorizontalAlignment="Center" FontSize="11" Foreground="#888888" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource AdminCardStyle}" Margin="30,0,30,12" Padding="14">
                <DataGrid x:Name="DgCe"
                  Style="{StaticResource AdminDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource AdminDataGridColumnHeaderStyle}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="False"
                  SelectionChanged="DgCe_SelectionChanged"
                  CellEditEnding="DgCe_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50" IsReadOnly="True" Visibility="Hidden"/>
                        <DataGridTextColumn Header="Produto" Binding="{Binding Nome}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Tamanho" Binding="{Binding Tamanho}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Preço (R$)" Binding="{Binding Preco, StringFormat={}{0:F2}}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade}" Width="120" IsReadOnly="False"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                <Button x:Name="BtnAtualizar" Content="Atualizar Lista" Style="{StaticResource AdminSecondaryButtonStyle}" Margin="6" Click="BtnAtualizar_Click"/>
                <Button x:Name="BtnRemover" Content="Remover Selecionado" Style="{StaticResource AdminDangerButtonStyle}" Margin="6" Click="BtnRemover_Click"/>
                <Button x:Name="BtnVoltar" Content="Voltar" Style="{StaticResource AdminSecondaryButtonStyle}" Margin="6" Click="BtnVoltar_Click"/>
            </StackPanel>
        </Grid>
    </Viewbox>
    
</Page>
