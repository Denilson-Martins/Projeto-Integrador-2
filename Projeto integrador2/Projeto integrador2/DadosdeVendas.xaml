<Page x:Class="Projeto_integrador2.DadosdeVendas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_integrador2"
        mc:Ignorable="d"
        Title="DadosdeVendas" d:DesignHeight="450" d:DesignWidth="800">
    <Viewbox Stretch="Fill">
        <Grid Width="800" Height="450">
            <Grid.Background>
                <ImageBrush ImageSource="/Background3.png" Stretch="UniformToFill"/>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource AdminCardStyle}" HorizontalAlignment="Center"
            Margin="0,30,0,0" Padding="26,12">
                <TextBlock Text="Painel do Administrador" Style="{StaticResource AdminTitleStyle}"/>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Button Click="BtnEstoque" Style="{StaticResource AdminPrimaryButtonStyle}" Width="220" Height="140" Margin="15">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📦" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Controle de Estoque" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="White"/>
                    </StackPanel>
                </Button>

                <Button Click="BtnVendas" Style="{StaticResource AdminPrimaryButtonStyle}" Width="220" Height="140" Margin="15">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🧾" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Controle de Vendas" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="White"/>
                    </StackPanel>
                </Button>

            </StackPanel>

            <Button Grid.Row="2" Content="Voltar" Click="BtnVoltar" Style="{StaticResource AdminSecondaryButtonStyle}"
            HorizontalAlignment="Center" Width="140" Margin="0,0,0,25"/>
        </Grid>
    </Viewbox>
    
</Page>
