            <Button Content="" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" Click="BtnVoltar" RenderTransformOrigin="4.854,1.074" Canvas.Left="321" Height="175" Width="186" BorderBrush="{x:Null}">
                <Button.Background>
                    <ImageBrush  ImageSource="/ChatGPT Image 29 de jun. de 2026, 20_00_35.png"/>
                </Button.Background>
            </Button>

        </Canvas>
    </Viewbox>

</Page>
