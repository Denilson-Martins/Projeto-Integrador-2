            <Button Style="{StaticResource VoltarButtonStyle}" Content="Selecionar Bebida" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" Click="BtnBebidas" Canvas.Left="73" Canvas.Top="312" Height="40" Width="180"  />
