<Page x:Class="Projeto_integrador2.Pedido"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Projeto_integrador2"
      mc:Ignorable="d" d:DesignWidth="800"
      Title="Pedido" d:DesignHeight="450">
    <Viewbox Stretch="Fill">
        <Canvas Width="800" Height="464" Background="White" >


            <DataGrid x:Name="DgPedido" AutoGenerateColumns="False" CanUserDeleteRows="False" HorizontalAlignment="Left" Height="236" VerticalAlignment="Top" Width="788">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome"    Binding="{Binding Nome}"   Width="*"/>
                    <DataGridTextColumn Header="Tamanho" Binding="{Binding Tamanho}" Width="Auto"/>
                    <DataGridTextColumn Header="Valor"   Binding="{Binding Valor, StringFormat={}{0:C2}}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>


            <Border BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="6"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="16,10" Background="#FFF9F9F9" Canvas.Left="580" Canvas.Top="236">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Subtotal: " FontSize="18" FontWeight="Bold"
                       FontFamily="Segoe UI" VerticalAlignment="Center" Foreground="#FF333333"/>
                    <TextBlock x:Name="TxtSubtotal" Text="R$ 0,00" FontSize="18" FontWeight="Bold"
                       FontFamily="Segoe UI" VerticalAlignment="Center" Foreground="#FF228B22"/>
                </StackPanel>
            </Border>


            <Button Content="Remover" HorizontalAlignment="Left"
            VerticalAlignment="Top" Click="BtnRemove" FontSize="20"
            Background="#FFE84242" Foreground="White" BorderBrush="#FFCC0000"
            Padding="10,4" Canvas.Left="79" Canvas.Top="294"/>

            <Button Content="Voltar para a tela de Escolha" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="20"
            Click="BtnEscolherBebida" Canvas.Left="31" Canvas.Top="258"/>

            <Button Content="Finalizar Pedido" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20"
            Click="BtnFinalizar" Canvas.Left="58" Canvas.Top="357"/>

            <Button Content="Voltar" HorizontalAlignment="Left" VerticalAlignment="Top"
            Height="56" Width="148" FontSize="20" FontWeight="Bold"
            FontFamily="Segoe UI Black" Foreground="#FFE84242" Click="Button_Click" BorderBrush="Red" Canvas.Left="31" Canvas.Top="393">
                <Button.Background>
                    <ImageBrush/>
                </Button.Background>
            </Button>

        </Canvas>
    </Viewbox>

</Page>
