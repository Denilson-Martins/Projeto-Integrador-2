<Page x:Class="Projeto_integrador2.Pedido"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Projeto_integrador2"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Pedido">

    <Grid Background="White">

        
        <DataGrid x:Name="DgPedido" AutoGenerateColumns="False" CanUserDeleteRows="False" Margin="0,0,0,203">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome"    Binding="{Binding Nome}"   Width="*"/>
                <DataGridTextColumn Header="Tamanho" Binding="{Binding Tamanho}" Width="Auto"/>
                <DataGridTextColumn Header="Valor"   Binding="{Binding Valor, StringFormat={}{0:C2}}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Painel de Subtotal -->
        <Border BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="6"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,23,209" Padding="16,10" Background="#FFF9F9F9">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Subtotal: " FontSize="18" FontWeight="Bold"
                           FontFamily="Segoe UI" VerticalAlignment="Center" Foreground="#FF333333"/>
                <TextBlock x:Name="TxtSubtotal" Text="R$ 0,00" FontSize="18" FontWeight="Bold"
                           FontFamily="Segoe UI" VerticalAlignment="Center" Foreground="#FF228B22"/>
            </StackPanel>
        </Border>

       
        <Button Content="Remover" HorizontalAlignment="Left" Margin="31,301,0,0"
                VerticalAlignment="Top" Click="BtnRemove" FontSize="20"
                Background="#FFE84242" Foreground="White" BorderBrush="#FFCC0000"
                Padding="10,4"/>

        <Button Content="Voltar para a tela de Escolha" HorizontalAlignment="Left"
                Margin="31,252,0,0" VerticalAlignment="Top" FontSize="20"
                Click="BtnEscolherBebida"/>

        <Button Content="Finalizar Pedido" HorizontalAlignment="Left"
                Margin="31,348,0,0" VerticalAlignment="Top" FontSize="20"
                Click="BtnFinalizar"/>

        <Button Content="Voltar" HorizontalAlignment="Left" VerticalAlignment="Top"
                Height="56" Width="148" FontSize="20" FontWeight="Bold"
                FontFamily="Segoe UI Black" Foreground="#FFE84242"
                Margin="10,384,0,0" Click="Button_Click" BorderBrush="Red">
            <Button.Background>
                <ImageBrush/>
            </Button.Background>
        </Button>

    </Grid>
</Page>
