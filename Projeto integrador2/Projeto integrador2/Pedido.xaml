<Page x:Class="Projeto_integrador2.Pedido"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Projeto_integrador2"
      mc:Ignorable="d" d:DesignWidth="800"
      Title="Pedido" d:DesignHeight="450">
    <Viewbox Stretch="Fill">

        <Canvas Width="800" Height="464" Background="White">

            <DataGrid x:Name="DgPedido"
                      AutoGenerateColumns="False" CanUserDeleteRows="False"
                      Width="800" Height="236"
                      Canvas.Left="0" Canvas.Top="0"
                      HorizontalAlignment="Left" VerticalAlignment="Top" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome"       Binding="{Binding Nome}"      Width="*"/>
                    <DataGridTextColumn Header="Tamanho"    Binding="{Binding Tamanho}"   Width="Auto"/>
                    <DataGridTextColumn Header="Valor Unit" Binding="{Binding Valor, StringFormat={}{0:C2}}" Width="Auto"/>
                    <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade}" Width="Auto"/>
                    <DataGridTextColumn Header="Subtotal"   Binding="{Binding Subtotal, StringFormat={}{0:C2}}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>

            <Rectangle Canvas.Left="0" Canvas.Top="236"
                       Width="800" Height="1"
                       Fill="#FFCCCCCC"/>

            <Button Content="−  Quantidade"
                    Click="BtnDiminuir"
                    Canvas.Left="20" Canvas.Top="256"
                    Width="170" Height="44" FontSize="17"
                    Background="#FFE84242" Foreground="White"
                    BorderBrush="#FFCC0000" FontWeight="SemiBold" Style="{StaticResource VoltarButtonStyle}" />

            <Button Content="Adicionar  +"
                    Click="BtnAdicionar"
                    Canvas.Left="205" Canvas.Top="256"
                    Width="170" Height="44" FontSize="17"
                    Background="#FF228B22" Foreground="White"
                    BorderBrush="#FF006400" FontWeight="SemiBold" Style="{StaticResource VoltarButtonStyle}"/>

            <Button Content="Remover Item"
                    Click="BtnRemove"
                    Canvas.Left="20" Canvas.Top="316"
                    Width="355" Height="44" FontSize="17"
                    Background="#FFE84242" Foreground="White"
                    BorderBrush="#FFCC0000" FontWeight="SemiBold" Style="{StaticResource VoltarButtonStyle}"/>

            <Button Content="← Voltar"
                    Click="BtnVoltar"
                    Canvas.Left="20" Canvas.Top="376"
                    Width="355" Height="44" FontSize="17"
                    Foreground="#FFF9F9F9" BorderBrush="White" FontWeight="Bold" Style="{StaticResource VoltarButtonStyle}">
                <Button.Background>
                    <SolidColorBrush Color="White"/>
                </Button.Background>
            </Button>

            <Rectangle Canvas.Left="395" Canvas.Top="244"
                       Width="1" Height="208"
                       Fill="#FFCCCCCC"/>

            <Border Canvas.Left="410" Canvas.Top="256"
                    Width="370" Height="44"
                    BorderBrush="#FFCCCCCC" BorderThickness="1"
                    CornerRadius="4" Background="#FFF9F9F9" >
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Subtotal: "
                               FontSize="18" FontWeight="Bold"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Foreground="#FF333333"/>
                    <TextBlock x:Name="TxtSubtotal" Text="R$ 0,00"
                               FontSize="18" FontWeight="Bold"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Foreground="#FF228B22"/>
                </StackPanel>
            </Border>

            <Button Content="Finalizar Pedido ✔"
                    Click="BtnFinalizar"
                    Canvas.Left="410" Canvas.Top="316"
                    Width="370" Height="44" FontSize="17"
                    Background="#FF1565C0" Foreground="White"
                    BorderBrush="#FF0D47A1" FontWeight="SemiBold" Style="{StaticResource VoltarButtonStyle}"/>

            <Button Content="← Voltar para a tela de Escolha"
                    Click="BtnEscolherBebida"
                    Canvas.Left="410" Canvas.Top="376"
                    Width="370" Height="44" FontSize="15"
                    Background="White" Foreground="White"
                    BorderBrush="White" FontWeight="SemiBold" Style="{StaticResource VoltarButtonStyle}"/>

        </Canvas>
    </Viewbox>
</Page>
