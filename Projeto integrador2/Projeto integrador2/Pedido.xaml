<Page x:Class="Projeto_integrador2.Pedido"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Projeto_integrador2"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Pedido">

    <Grid Background="White">
        <DataGrid x:Name="DgPedido" AutoGenerateColumns="False">
            <DataGrid.Columns>
                
            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}"/>
            <DataGridTextColumn Header="Tamanho" Binding="{Binding Tamanho}"/>
            <DataGridTextColumn Header="Valor" Binding="{Binding Valor}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
