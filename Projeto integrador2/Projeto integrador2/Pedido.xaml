<Page x:Class="Projeto_integrador2.Pedido"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Projeto_integrador2"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Pedido">

    <Grid Background="White">
        <DataGrid x:Name="DgPedido" AutoGenerateColumns="False" CanUserDeleteRows="True" Margin="0,0,0,71">
            <DataGrid.Columns>

                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}"/>
                <DataGridTextColumn Header="Tamanho" Binding="{Binding Tamanho}"/>
                <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat={}{0:C2}}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Voltar" HorizontalAlignment="Left" VerticalAlignment="Top" Height="56" Width="148" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Black" Foreground="#FFE84242" Margin="10,384,0,0" Click="Button_Click" BorderBrush="Red">
            <Button.Background>
                <ImageBrush/>
            </Button.Background>
        </Button>
        <Button Content="Remover" HorizontalAlignment="Center" Margin="0,405,0,0" VerticalAlignment="Top" Click="BtnRemove" FontSize="20"/>
        <Button Content="Finalizar Pedido" HorizontalAlignment="Left" Margin="634,405,0,0" VerticalAlignment="Top" FontSize="20" Click="BtnFinalizar"/>
    </Grid>
</Page>
