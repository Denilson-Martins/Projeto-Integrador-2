<Page x:Class="Projeto_integrador2.ControleDeVendas"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Projeto_integrador2"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="ControleDeVendas" Loaded="Page_Loaded">

    <Viewbox Stretch="Fill">
        <Grid Width="800" Height="550">
            <Grid.Background>
                <ImageBrush ImageSource="/Background3.png" Stretch="UniformToFill"/>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.15*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource AdminCardStyle}" HorizontalAlignment="Center"
            Margin="0,18,0,12" Padding="26,10">
                <TextBlock Text="Controle de Vendas" Style="{StaticResource AdminTitleStyle}"/>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource AdminCardStyle}" Margin="30,0,30,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Vendas realizadas (clique em uma para ver os itens)"
                       Style="{StaticResource AdminSubtitleStyle}" Margin="0,0,0,8"/>
                    <DataGrid x:Name="DgVendas" Grid.Row="1"
                      Style="{StaticResource AdminDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource AdminDataGridColumnHeaderStyle}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionChanged="DgVendas_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nº Venda" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150"/>
                            <DataGridTextColumn Header="Forma de Pagamento" Binding="{Binding FormaPagamento}" Width="*"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:C2}}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource AdminCardStyle}" Margin="30,0,30,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Itens da venda selecionada"
                       Style="{StaticResource AdminSubtitleStyle}" Margin="0,0,0,8"/>
                    <DataGrid x:Name="DgItensVenda" Grid.Row="1"
                      Style="{StaticResource AdminDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource AdminDataGridColumnHeaderStyle}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome"       Binding="{Binding Nome}"                            Width="*"/>
                            <DataGridTextColumn Header="Tamanho"    Binding="{Binding Tamanho}"                         Width="Auto"/>
                            <DataGridTextColumn Header="Valor Unit" Binding="{Binding Valor, StringFormat={}{0:C2}}"    Width="Auto"/>
                            <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade}"                      Width="Auto"/>
                            <DataGridTextColumn Header="Subtotal"   Binding="{Binding Subtotal, StringFormat={}{0:C2}}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                <Button x:Name="BtnAtualizar" Content="Atualizar Lista" Style="{StaticResource AdminSecondaryButtonStyle}" Margin="6" Click="BtnAtualizar_Click"/>
                <Button x:Name="BtnVoltar" Content="Voltar" Style="{StaticResource AdminSecondaryButtonStyle}" Margin="6" Click="BtnVoltar_Click"/>
            </StackPanel>
        </Grid>
    </Viewbox>
    
</Page>
