<Page x:Class="Projeto_integrador2.CADASTRO"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Projeto_integrador2"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CADASTRO">

    <Grid Background="White">
        <Label Content="Nome" HorizontalAlignment="Left" Margin="80,80,0,0" VerticalAlignment="Top"/>
        <Label Content="Senha" HorizontalAlignment="Left" Margin="80,185,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txbUser" HorizontalAlignment="Left" Margin="155,88,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="txbSenha" HorizontalAlignment="Left" Margin="155,193,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <Button Click="BtnCadastrarClick" Content="Cadastro" HorizontalAlignment="Center" Margin="0,385,0,0" VerticalAlignment="Top"/>

    </Grid>
</Page>
