<Page x:Class="Projeto_integrador2.CADASTRO"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Projeto_integrador2"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CADASTRO">

    <Viewbox Stretch="Fill">
        <Canvas Width="800" Height="450" Background="White">
            <Label Content="Nome" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="-3.731,-0.413" Canvas.Left="284" Canvas.Top="93"/>
            <Label Content="Senha" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="284" Canvas.Top="171"/>
            <TextBox x:Name="txbUser" HorizontalAlignment="Left" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Canvas.Left="525" Canvas.Top="106" TextChanged="txbUser_TextChanged"/>
            <TextBox x:Name="txbSenha" HorizontalAlignment="Left" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Canvas.Left="525" Canvas.Top="171"/>
            <Button Content="Cadastro" HorizontalAlignment="Left" VerticalAlignment="Top" Height="55" Width="132" Canvas.Left="222" Canvas.Top="321" Click="Button_Click_1"/>
            <Label Content="Label" HorizontalAlignment="Left" Height="0" Margin="215,106,0,0" VerticalAlignment="Top" Width="13"/>
            <Label Content="Email" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.235,0.886" Canvas.Left="284" Canvas.Top="234"/>
            <TextBox x:Name="txbEmail" HorizontalAlignment="Left" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Canvas.Left="525" Canvas.Top="242"/>

        </Canvas>
    </Viewbox>


</Page>
