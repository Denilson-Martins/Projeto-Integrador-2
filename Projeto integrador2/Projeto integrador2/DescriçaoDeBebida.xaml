<Page x:Class="Projeto_integrador2.Descrição_do_produto"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Projeto_integrador2"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Descrição_do_produto">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="26*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="15*"/>
        </Grid.RowDefinitions>

        <Image Margin="69,28,455,46" Source="/img (2).jpeg" Stretch="Fill"/>
        <Label Content="Cappuccino" HorizontalAlignment="Left" Margin="400,28,0,0" VerticalAlignment="Top" FontSize="20" Height="37" Width="114" Background="White"/>
        <TextBox HorizontalAlignment="Left" Margin="400,96,0,0" TextWrapping="Wrap" Text="Uma combinação equilibrada de café espresso encorpado, leite vaporizado e uma camada cremosa de espuma de leite. Finalizado com um toque de  canela, oferece aroma marcante, textura aveludada e sabor suave, perfeito para qualquer momento do dia." VerticalAlignment="Top" Width="390" FontSize="16" Height="108" Background="White">
            <TextBox.BorderBrush>
                <ImageBrush/>
            </TextBox.BorderBrush>
        </TextBox>
        <Label Content="Ingredientes" HorizontalAlignment="Left" Margin="400,211,0,0" VerticalAlignment="Top" FontSize="20" Height="37" Width="120"/>
        <TextBox HorizontalAlignment="Left" Margin="400,0,0,0" TextWrapping="Wrap" Text="leite em pó &#xD;&#xA;café solúvel &#xD;&#xA;achocolatado em pó&#xD;&#xA;açúcar &#xD;&#xA;canela em pó &#xD;&#xA;bicarbonato de sódio" VerticalAlignment="Top" Width="390" FontSize="16" Grid.RowSpan="2" Height="130" Grid.Row="1" Background="White">
            <TextBox.BorderBrush>
                <ImageBrush/>
            </TextBox.BorderBrush>
        </TextBox>
        <Label Content="Preço" HorizontalAlignment="Left" Margin="182,225,0,0" VerticalAlignment="Top" FontSize="16" Height="31" Width="50"/>
        <Label Content="R$ 6,00" HorizontalAlignment="Left" Margin="120,256,0,0" VerticalAlignment="Top" FontSize="16" Height="31" Width="62" Grid.RowSpan="2"/>
        <Label Content="R$ 12,00" HorizontalAlignment="Left" Margin="231,256,0,0" VerticalAlignment="Top" FontSize="16" Height="31" Width="71" Grid.RowSpan="2"/>

        <Button Tag="Cappuccino" Content="100ml" HorizontalAlignment="Left" Margin="127,12,0,0" VerticalAlignment="Top" FontSize="16" Click="BtnCapMl" Height="25" Grid.Row="2" Width="48"/>
        <Button Tag="Cappuccino" Content="200ml" HorizontalAlignment="Left" Margin="243,12,0,0" VerticalAlignment="Top" FontSize="16" Click="BtnCapMl" Height="25" Grid.Row="2" Width="48"/>

        <Button Content="Voltar" HorizontalAlignment="Left" VerticalAlignment="Top" Height="56" Width="148" FontSize="20" FontWeight="Bold" FontFamily="Segoe UI Black" Foreground="#FFE84242" Margin="27,77,0,0" Grid.Row="2" Click="Button_Click" BorderBrush="Red">
            <Button.Background>
                <ImageBrush/>
            </Button.Background>
        </Button>


    </Grid>
</Page>
