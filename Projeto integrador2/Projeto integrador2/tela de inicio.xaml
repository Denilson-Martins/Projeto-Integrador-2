<Window x:Class="Projeto_integrador2.tela_de_inicio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_integrador2"
        mc:Ignorable="d"
        Title="tela_de_inicio" Height="450" Width="800">
    <Grid Background="#FFFFC90B">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="721*"/>
            <ColumnDefinition Width="79*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="button" Content="ENTRAR" HorizontalAlignment="Left" Margin="317,350,0,0" VerticalAlignment="Top" Height="74" Width="204" Foreground="#FF0A1188" FontFamily="Franklin Gothic Heavy" FontSize="36" FontWeight="Bold" FontStyle="Italic" BorderBrush="#FF24379E" OpacityMask="{DynamicResource {x:Static SystemColors.GradientInactiveCaptionBrushKey}}" Background="{x:Null}" Click="button_Click">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>
        <Image Margin="256,0,131,89" Source="/7478dbd1-6335-4cc6-9549-6fa2db4e2ccc.png" Stretch="Fill"/>
        <Grid Grid.ColumnSpan="2" Margin="40,-196,40,196"/>

    </Grid>
</Window>
