<Application x:Class="Projeto_integrador2.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Projeto_integrador2"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Botão de foto de lanche: moldura dourada fina, sem o "chrome" padrão do botão -->
        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borda"
                         Background="{TemplateBinding Background}"
                         BorderBrush="#C9A876"
                         BorderThickness="1.3"
                         SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="0.55"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borda" Property="BorderBrush" Value="#F3DDB2"/>
                                <Setter TargetName="borda" Property="BorderThickness" Value="2.2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Linha dourada fina abaixo da foto -->
        <Style x:Key="TileDividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1.3"/>
            <Setter Property="Fill" Value="#C9A876"/>
        </Style>

        <!-- Nome do lanche -->
        <Style x:Key="TileNameStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#F1D7AC"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- Pequeno florão decorativo abaixo do nome -->
        <Style x:Key="TileFlourishStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#C9A876"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- Botão Voltar: caixa escura com moldura dupla dourada -->
        <Style x:Key="VoltarButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Foreground" Value="#F1D7AC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="#E6141009" BorderBrush="#C9A876" BorderThickness="1.3"/>
                            <Border Margin="5" BorderBrush="#C9A876" BorderThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
