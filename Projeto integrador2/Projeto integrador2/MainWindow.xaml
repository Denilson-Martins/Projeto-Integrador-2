<Window x:Class="Projeto_integrador2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_integrador2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="White">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!---Menu-->
        <StackPanel Background="#FF337880">

            <TextBlock Text="Cafeteria"
                    Foreground="Cornsilk"
                    FontSize="22"
                    Margin="20"/>

            <Button Content="HOME" Height="40" Margin="10" Click="BtnHome_Click"/>
            <Button Content="CADASTRO DE PRODUTOS" Height="40" Margin="10" Click="BtnCadastroProdutos_Click"/>






        </StackPanel>



        <!--Conteudo-->
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden">



        </Frame>

    </Grid>
</Window>
