<Window x:Class="Projeto_integrador2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_integrador2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Background>
        <ImageBrush ImageSource="/top-view-coffee-tamper-with-copy-space.jpg"/>
    </Window.Background>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Frame x:Name="MainFrame" Grid.Column="1"
               NavigationUIVisibility="Hidden"/>
        <Button Grid.Column="1" Content="" HorizontalAlignment="Left" Margin="30,31,0,0" VerticalAlignment="Top" Height="83" Width="100" Click="Button_Click">
            <Button.Background>
                <ImageBrush ImageSource="/WhatsApp Image 2026-05-26 at 20.10.07.jpeg"/>
            </Button.Background>
        </Button>
        <Button Grid.Column="1" Content="" HorizontalAlignment="Left" Margin="149,31,0,0" VerticalAlignment="Top" Height="83" Width="106" Click="Button_Click_1">
            <Button.Background>
                <ImageBrush ImageSource="/WhatsApp Image 2026-05-26 at 20.10.53.jpeg"/>
            </Button.Background>
        </Button>
        <Button Grid.Column="1" Content="" HorizontalAlignment="Left" Margin="268,31,0,0" VerticalAlignment="Top" Height="83" Width="114" Click="Button_Click_1">
            <Button.Background>
                <ImageBrush ImageSource="/WhatsApp Image 2026-05-26 at 20.11.21.jpeg"/>
            </Button.Background>
        </Button>
        <Button Grid.Column="1" Content="" HorizontalAlignment="Left" Margin="395,31,0,0" VerticalAlignment="Top" Height="83" Width="106" Click="Button_Click_1">
            <Button.Background>
                <ImageBrush ImageSource="/WhatsApp Image 2026-05-26 at 20.11.57.jpeg"/>
            </Button.Background>
        </Button>
        <Button Grid.Column="1" Content="" HorizontalAlignment="Left" Margin="30,159,0,0" VerticalAlignment="Top" Height="84" Width="100" Click="Button_Click_1">
            <Button.Background>
                <ImageBrush ImageSource="/WhatsApp Image 2026-05-26 at 20.12.11.jpeg"/>
            </Button.Background>
        </Button>
        <Label Grid.Column="1" Content="" HorizontalAlignment="Left" Margin="180,181,0,0" VerticalAlignment="Top"/>
        <Image Margin="155,159,325,191" Source="/Image1.png" Stretch="Fill" Grid.Column="1"/>
        <TextBox Grid.Column="1" HorizontalAlignment="Left" Margin="173,247,0,0" TextWrapping="Wrap" Text="Ice Latte" VerticalAlignment="Top" Width="56" BorderBrush="White"/>
        <Image Margin="275,159,205,191" Source="/Image2.png" Stretch="Fill" Grid.Column="1"/>
        <Image Margin="399,157,69,191" Source="/Image3.png" Stretch="Fill" Grid.Column="1" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.075"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <Image Margin="30,291,450,54" Source="/Image4.png" Stretch="Fill" Grid.Column="1"/>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="287,248,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="Black"/>
        <TextBox Grid.Column="1" HorizontalAlignment="Left" Margin="421,246,0,0" TextWrapping="Wrap" Text="Cold Brew" VerticalAlignment="Top" Width="63" BorderBrush="White"/>
        <TextBox Grid.Column="1" HorizontalAlignment="Left" Margin="36,385,0,0" TextWrapping="Wrap" Text="Iced Mocha" VerticalAlignment="Top" Width="88" BorderBrush="White"/>
        <Image Margin="155,291,325,54" Source="/Image5.png" Stretch="Fill" Grid.Column="1"/>
        <TextBox Grid.Column="1" HorizontalAlignment="Left" Margin="149,385,0,0" TextWrapping="Wrap" Text="creamy iced coffee" VerticalAlignment="Top" Width="111" BorderBrush="White"/>
        <TextBox Grid.Column="1" HorizontalAlignment="Left" Margin="275,246,0,0" TextWrapping="Wrap" Text="Frappuccino" VerticalAlignment="Top" Width="74" TextChanged="TextBox_TextChanged_1"/>
        <TextBox Grid.Column="1" HorizontalAlignment="Left" Margin="44,246,0,0" TextWrapping="Wrap" Text="Moccha" VerticalAlignment="Top" Width="56" BorderBrush="White" TextChanged="TextBox_TextChanged_1"/>
        <TextBox Grid.Column="1" HorizontalAlignment="Left" Margin="44,122,0,0" TextWrapping="Wrap" Text="Expresso" VerticalAlignment="Top" Width="56"/>
        <TextBox Grid.Column="1" HorizontalAlignment="Left" Margin="315,121,0,0" TextWrapping="Wrap" Text="Latte" VerticalAlignment="Top" Width="34"/>
        <TextBox Grid.Column="1" HorizontalAlignment="Left" Margin="418,122,0,0" TextWrapping="Wrap" Text="Americano" VerticalAlignment="Top" Width="66"/>
        <TextBox Grid.Column="1" HorizontalAlignment="Left" Margin="168,122,0,0" TextWrapping="Wrap" Text="cappuccino" VerticalAlignment="Top" Width="70"/>
    </Grid>
</Window>



