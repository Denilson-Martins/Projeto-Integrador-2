            <TextBlock Text="◆" Style="{StaticResource TileFlourishStyle}" Canvas.Left="366" Canvas.Top="290" Width="105"/>

            
            <Button Style="{StaticResource TileButtonStyle}" Canvas.Left="15" Canvas.Top="301" Width="105" Height="105">
