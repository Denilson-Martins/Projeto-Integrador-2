            <TextBlock Text="Ice Latte" Style="{StaticResource TileNameStyle}" Canvas.Left="15" Canvas.Top="412" Width="105"/>
            <TextBlock Text="◆" Style="{StaticResource TileFlourishStyle}" Canvas.Left="15" Canvas.Top="433" Width="105"/>

            <Button Style="{StaticResource TileButtonStyle}" Canvas.Left="132" Canvas.Top="301" Width="105" Height="105">
                <Button.Background>
                    <ImageBrush ImageSource="/Image5.png" Stretch="UniformToFill"/>
                </Button.Background>
            </Button>
            <Rectangle Style="{StaticResource TileDividerStyle}" Canvas.Left="132" Canvas.Top="409" Width="105"/>
            <TextBlock Text="Creamy Iced Coffe" Style="{StaticResource TileNameStyle}" Canvas.Left="132" Canvas.Top="412" Width="105" FontSize="11"/>
            <TextBlock Text="◆" Style="{StaticResource TileFlourishStyle}" Canvas.Left="132" Canvas.Top="433" Width="105"/>

            <Button Style="{StaticResource TileButtonStyle}" Canvas.Left="249" Canvas.Top="301" Width="105" Height="105">
                <Button.Background>
