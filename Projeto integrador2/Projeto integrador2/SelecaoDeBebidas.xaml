            <TextBlock Text="Agua (gás)" Style="{StaticResource TileNameStyle}" Canvas.Left="249" Canvas.Top="412" Width="105"/>
            <TextBlock Text="◆" Style="{StaticResource TileFlourishStyle}" Canvas.Left="249" Canvas.Top="433" Width="105"/>

