<Page x:Class="Projeto_integrador2.SelecaoDeBebidas"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Projeto_integrador2"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SelecaoDeBebidas">
    <Viewbox Stretch="Fill" >
        <Canvas Width="800" Height="450">

            <Canvas.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#221E1A" Offset="0"/>
                    <GradientStop Color="#121010" Offset="1"/>
                </LinearGradientBrush>
            </Canvas.Background>

            <Rectangle Canvas.Left="480" Canvas.Top="0" Width="320" Height="450">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="/PainelBebidas.jpg" Stretch="UniformToFill"/>
                </Rectangle.Fill>
            </Rectangle>

           
            <Button Style="{StaticResource TileButtonStyle}" Canvas.Left="15" Canvas.Top="15" Width="105" Height="105" Click="ButtonCappuccino">
                <Button.Background>
                    <ImageBrush ImageSource="/img (2).jpeg" Stretch="UniformToFill"/>
                </Button.Background>
            </Button>
            <Rectangle Style="{StaticResource TileDividerStyle}" Canvas.Left="15" Canvas.Top="123" Width="105"/>
            <TextBlock Text="Cappuccino" Style="{StaticResource TileNameStyle}" Canvas.Left="15" Canvas.Top="126" Width="105"/>
            <TextBlock Text="◆" Style="{StaticResource TileFlourishStyle}" Canvas.Left="15" Canvas.Top="147" Width="105"/>

            <Button Style="{StaticResource TileButtonStyle}" Canvas.Left="132" Canvas.Top="15" Width="105" Height="105">
                <Button.Background>
                    <ImageBrush ImageSource="/img (5).jpeg" Stretch="UniformToFill"/>
                </Button.Background>
            </Button>
            <Rectangle Style="{StaticResource TileDividerStyle}" Canvas.Left="132" Canvas.Top="123" Width="105"/>
            <TextBlock Text="Mocha" Style="{StaticResource TileNameStyle}" Canvas.Left="132" Canvas.Top="126" Width="105"/>
            <TextBlock Text="◆" Style="{StaticResource TileFlourishStyle}" Canvas.Left="132" Canvas.Top="147" Width="105"/>

            <Button Style="{StaticResource TileButtonStyle}" Canvas.Left="249" Canvas.Top="15" Width="105" Height="105">
                <Button.Background>
                    <ImageBrush ImageSource="/img (1).jpeg" Stretch="UniformToFill"/>
                </Button.Background>
            </Button>
            <Rectangle Style="{StaticResource TileDividerStyle}" Canvas.Left="249" Canvas.Top="123" Width="105"/>
            <TextBlock Text="Expresso" Style="{StaticResource TileNameStyle}" Canvas.Left="249" Canvas.Top="126" Width="105"/>
            <TextBlock Text="◆" Style="{StaticResource TileFlourishStyle}" Canvas.Left="249" Canvas.Top="147" Width="105"/>

            <Button Style="{StaticResource TileButtonStyle}" Canvas.Left="366" Canvas.Top="15" Width="105" Height="105">
                <Button.Background>
                    <ImageBrush ImageSource="/Cold Brew.jpeg" Stretch="UniformToFill"/>
                </Button.Background>
            </Button>
            <Rectangle Style="{StaticResource TileDividerStyle}" Canvas.Left="366" Canvas.Top="123" Width="105"/>
            <TextBlock Text="Cold Brew" Style="{StaticResource TileNameStyle}" Canvas.Left="366" Canvas.Top="126" Width="105"/>
            <TextBlock Text="◆" Style="{StaticResource TileFlourishStyle}" Canvas.Left="366" Canvas.Top="147" Width="105"/>

            
            <Button Style="{StaticResource TileButtonStyle}" Canvas.Left="15" Canvas.Top="158" Width="105" Height="105">
                <Button.Background>
                    <ImageBrush ImageSource="/img (3).jpeg" Stretch="UniformToFill"/>
                </Button.Background>
            </Button>
            <Rectangle Style="{StaticResource TileDividerStyle}" Canvas.Left="15" Canvas.Top="266" Width="105"/>
            <TextBlock Text="Latte" Style="{StaticResource TileNameStyle}" Canvas.Left="15" Canvas.Top="269" Width="105"/>
            <TextBlock Text="◆" Style="{StaticResource TileFlourishStyle}" Canvas.Left="15" Canvas.Top="290" Width="105"/>

            <Button Style="{StaticResource TileButtonStyle}" Canvas.Left="132" Canvas.Top="158" Width="105" Height="105">
                <Button.Background>
                    <ImageBrush ImageSource="/img (4).jpeg" Stretch="UniformToFill"/>
                </Button.Background>
            </Button>
            <Rectangle Style="{StaticResource TileDividerStyle}" Canvas.Left="132" Canvas.Top="266" Width="105"/>
            <TextBlock Text="Americano" Style="{StaticResource TileNameStyle}" Canvas.Left="132" Canvas.Top="269" Width="105"/>
            <TextBlock Text="◆" Style="{StaticResource TileFlourishStyle}" Canvas.Left="132" Canvas.Top="290" Width="105"/>

            <Button Style="{StaticResource TileButtonStyle}" Canvas.Left="249" Canvas.Top="158" Width="105" Height="105">
                <Button.Background>
                    <ImageBrush ImageSource="/Frappuchino.jpeg" Stretch="UniformToFill"/>
                </Button.Background>
            </Button>
            <Rectangle Style="{StaticResource TileDividerStyle}" Canvas.Left="249" Canvas.Top="266" Width="105"/>
            <TextBlock Text="Frappuccino" Style="{StaticResource TileNameStyle}" Canvas.Left="249" Canvas.Top="269" Width="105"/>
